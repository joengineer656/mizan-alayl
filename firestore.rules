rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Replace these with the two user IDs shown on the site after first sign-in.
    function isMember() {
      return request.auth != null && request.auth.uid in ['UID_ONE', 'UID_TWO'];
    }
    // Wider than the app's today/yesterday limit so every time zone and the 5:00 am day change still fit.
    function editable(date) {
      let start = timestamp.value(date + 'T00:00:00Z');
      return request.time > start - duration.value(1, 'd') && request.time < start + duration.value(3, 'd');
    }
    function validLog(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'date', 'pages', 'rakat', 'fajr'])
        && d.keys().hasAll(['uid', 'date', 'pages', 'rakat', 'fajr'])
        && d.uid == request.auth.uid
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && id == request.auth.uid + '_' + d.date
        && d.pages is int && d.pages >= 0 && d.pages <= 604
        && d.rakat is int && d.rakat >= 0 && d.rakat <= 99
        && d.fajr is bool
        && editable(d.date);
    }
    match /logs/{id} {
      allow read: if isMember();
      allow create, update: if isMember() && validLog(id);
    }
  }
}
